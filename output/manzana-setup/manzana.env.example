# /srv/cvm_portal/manzana.env — обходной путь «Заведение в Manzana» (задание cvm-manzana-setup на ru).
# Вне git, права 600. Пишет set-secrets.sh (пароли спрашивает без отображения) или Елена руками по этому образцу.
# Доступы и адреса дадут позже (ДИКСИ / Manzana). Пока значения пустые, задание работает только в режиме проверки
# (--check, --dry-run) и ничего в Manzana не делает.

# ---- Включение ---------------------------------------------------------------------------------
# 0 — задание читает очередь и пишет в журнал, что бы оно сделало; 1 — выполняет (только по слову Елены).
MANZANA_SETUP_ENABLED=0
# Какие части обходного пути включены: online — инфокупон акции для тестового показа в Manzana Online;
# campaign — кампания и сообщения в Manzana Campaign; lists — загрузка списка CRM_GUID в кампанию.
# Через запятую; пусто — все три.
MANZANA_SETUP_SYSTEMS=online,campaign,lists

# ---- Manzana Campaign: приложение, API и учётка робота (отдельная, не персональная) -------------
# Адреса — из программы ДИКСИ (веб-приложение и его API); менять только если Manzana их сменит.
MC_URL=https://campaign.manzanagroup.ru
MC_API_URL=https://apicampaign.manzanagroup.ru/v1/dixy
MC_LOGIN=
MC_PASSWORD=
# Секрет одноразовых кодов (TOTP), если у учётки второй фактор; пусто — без него.
MC_TOTP_SECRET=
# Партнёр / проект, который выбирается после входа, если их несколько.
MC_PARTNER=
# Селекторы формы входа — уточняются при первом входе робота; пусто — поле логина/почты, пароль, кнопка отправки, поле кода.
MC_LOGIN_SELECTOR=
MC_PASSWORD_SELECTOR=
MC_SUBMIT_SELECTOR=
MC_CODE_SELECTOR=

# ---- Списки в Campaign (протокол ДИКСИ: один импорт на список, итог — в базу списков) ----------------
# Списки робот берёт из базы списков cvm_lists (Postgres портала), не с SFTP-обмена (решение Елены 20.10.2026).
# Какие акции робот грузит в Campaign сам (решение Елены 20.10.2026 «2б»: списки грузит ДИКСИ, робот — только
# перечисленные, пока не договорились о передаче загрузки). Номера и диапазоны через ;  «all» — все; пусто — ни одной.
LISTS_PROMOS=
# Постфикс к названию МС «<номер>_<title>»; пусто — без постфикса.
LISTS_POSTFIX=
# 1 — импорт с передачей в Manzana Online (destination campml, название ≤ 50 знаков); 0 — только Campaign.
LISTS_SEND_TO_MO=0
# Хост хранилища, куда Campaign выдаёт временную ссылку для файла списка (из кода ДИКСИ); другой хост отклоняется.
S3_UPLOAD_HOST=dixy-mlistimport.hb.bizmrg.com

# ---- Manzana Online: инфокупон для тестового показа -------------------------------------------
# Раздел Loyalty того же приложения Campaign (API /mlp/ml/*), та же учётка робота — отдельных доступов нет
# (Елена 20.10.2026: одна учётка с теми же правами в Campaign и Loyalty). Акцию и механику заводит MCI сама.
# Реестр черновиков инфокупонов «Инфокупон N» (заводятся руками в Manzana; у каждого — ID правила и CRM GUID
# купона, который API не отдаёт). Ведёт Елена; на ru — /srv/cvm_portal/manzana-state/coupon_drafts.json:
#   [{"rule_id": 123, "url": "https://campaign.manzanagroup.ru/loyalty/marketing/rules/ChargeRuleBaseView/edit/123",
#     "guid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx", "used_by": ""}]
# Робот занимает первый свободный (used_by = «<номер>_<старт>»).
COUPON_DRAFTS=/state/coupon_drafts.json

# ---- Админка купонов ДИКСИ (кнопка инфокупона в приложении): своя учётка робота -------------------
LOYALTY_ADMIN_URL=https://loyalty-admin.dixy.ru
LOYALTY_ADMIN_LOGIN=
LOYALTY_ADMIN_PASSWORD=

# ---- Браузер ------------------------------------------------------------------------------------
# Постоянный профиль Chromium (хранит вход); на ru — /srv/cvm_portal/manzana/profile (700, uid 10010).
BROWSER_PROFILE_DIR=/profile
# 0 — через Xvfb, если расширение не работает в headless-режиме.
BROWSER_HEADLESS=1
# Ожидание одного шага на странице, секунд.
BROWSER_TIMEOUT_SEC=120
# Снимок экрана при ошибке → failed/ рядом со списком, хранится RETENTION_DAYS дней.
BROWSER_SCREENSHOT_ON_ERROR=1

# ---- Состояние робота -------------------------------------------------------------------------------
# Журнал, отметки и технические реестры этого задания; на ru — /srv/cvm_portal/manzana-state.
LISTS_STATE=/state
RETENTION_DAYS=14

# ---- База портала: только чтение (роль создаёт set-secrets.sh) ----------------------------------
PG_HOST=cvm-db
PG_PORT=5432
PG_DB=
PG_USER=cvm_manzana_ro
PG_PASSWORD=

# ---- База списков cvm_lists (контейнер cvm-lists-db): списки и итог заведения в lists.manzana ----------
# Роль lists_manzana — миграция портала db/lists/002_manzana.sql и строка в pg_hba.conf (db/lists/setup.sh);
# пароль ставит set-secrets.sh. Читает номер, старт, имя кампании, число CRM_GUID и участников; пишет только итог.
LISTS_PG_HOST=cvm-lists-db
LISTS_PG_PORT=5432
LISTS_PG_DB=cvm_lists
LISTS_PG_USER=lists_manzana
LISTS_PG_PASSWORD=

# ---- Уведомления о сбоях (письма через SMTP портала; подключается позже) -------------------------
NOTIFY_TO=

# ---- PUSH-кампании в Campaign (протокол ДИКСИ: шаблон + неактивная кампания из заготовки) ----------
# Тестовые телефоны для тестовой отправки (через ; ), как у ДИКСИ обязательны.
PUSH_TEST_RECIPIENTS=
# Заготовки кампаний ДИКСИ без контрольной группы на 1 / 2 / 3 блока отправки (из их кода); учётка робота должна их видеть.
PUSH_BLUEPRINT_1=68ece43ec1c4a64e15a374b0
PUSH_BLUEPRINT_2=6aa97c65cd1570a97ad36bcf
PUSH_BLUEPRINT_3=6aa97d2ccd1570a97ad36f1e
# 1 — после сохранения активировать кампанию (POST /camps/status); 0 — оставить неактивной, как делает ДИКСИ (активирует менеджер).
PUSH_ACTIVATE=0
# Исключаемые МС (имена через ; ) для всех кампаний робота; пусто — без исключений.
PUSH_EXCLUDE_LISTS=
