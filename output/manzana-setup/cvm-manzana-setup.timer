[Unit]
Description=Каждые 15 минут заводить в Manzana согласованные акции, кампании и списки (обходной путь)

[Timer]
# Через 7 минут после задания списков (cvm-campaign-lists — :00/15): список, согласованный к этому времени, уже обработан и заданием списков для ДИКСИ.
OnCalendar=*:07/15
Persistent=true
Unit=cvm-manzana-setup.service

[Install]
WantedBy=timers.target
